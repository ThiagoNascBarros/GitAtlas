{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitAtlas",
  "version": "0.1.0",
  "identifier": "dev.gitatlas.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "GitAtlas", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600, "dragDropEnabled": false, "devtools": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "licenseFile": "../../LICENSE",
    "category": "DeveloperTool",
    "publisher": "GitAtlas contributors",
    "homepage": "https://github.com/ThiagoNascBarros/GitAtlas",
    "shortDescription": "Fast, friendly Git client",
    "longDescription": "GitAtlas is a desktop Git client for Linux: commit graph, staging, commits, branches, merges, stashes, remotes and rebase. Every change is made with the Git command line (Git 2.20 or newer).",
    "linux": {
      "deb": {
        "depends": ["git (>= 1:2.20)"],
        "section": "vcs",
        "priority": "optional",
        "desktopTemplate": "../../packaging/linux/dev.gitatlas.app.desktop",
        "files": {
          "/usr/share/metainfo/dev.gitatlas.app.metainfo.xml": "../../packaging/linux/dev.gitatlas.app.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/dev.gitatlas.app.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/dev.gitatlas.app.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/dev.gitatlas.app.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/dev.gitatlas.app.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/dev.gitatlas.app.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/dev.gitatlas.app.png": "icons/icon.png"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/metainfo/dev.gitatlas.app.metainfo.xml": "../../packaging/linux/dev.gitatlas.app.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/dev.gitatlas.app.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/dev.gitatlas.app.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/dev.gitatlas.app.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/dev.gitatlas.app.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/dev.gitatlas.app.png": "icons/256x256.png",
          "/usr/share/icons/hicolor/512x512/apps/dev.gitatlas.app.png": "icons/icon.png"
        }
      }
    }
  }
}
