[Desktop Entry]
Type=Application
Name=GitAtlas
GenericName=Git Client
GenericName[pt_BR]=Cliente Git
Comment=Browse history, commit, branch, merge and sync Git repositories
Comment[pt_BR]=Navegue pelo histórico, faça commits, branches, merges e sincronize repositórios Git
Exec=gitatlas %f
Icon=dev.gitatlas.app
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;vcs;version control;repository;commit;branch;merge;
Keywords[pt_BR]=git;vcs;controle de versão;repositório;commit;branch;merge;
StartupNotify=true
StartupWMClass=gitatlas
